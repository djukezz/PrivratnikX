# Скопировать в keystore.properties и заполнить. keystore.properties в git не попадает.
# Без него release подписывается debug-ключом.
# storeFile — путь к ключу относительно корня проекта или абсолютный (слэши прямые: E:/keys/release.jks)
storeFile=E:/keys/release.jks
storePassword=
keyAlias=
keyPassword=
